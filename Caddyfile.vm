cc.chatgo.ia.bo {
    handle /api/* {
        reverse_proxy api:8080
    }

    handle {
    root * /srv
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Cache-Control no-cache
    }

    @modules path *.mjs
    header @modules Content-Type "text/javascript; charset=utf-8"

    file_server
    }
}
